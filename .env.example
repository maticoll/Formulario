# Neon Database URL
# Obtené tu connection string desde el dashboard de Neon
DATABASE_URL=

# Anthropic API Key (opcional)
# Sin esto, el explorador usa los resúmenes pre-generados de src/lib/digests.ts.
# Con esto, /api/explorer/summary genera los resúmenes con IA y los cachea.
# Obtené la key en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Clave de acceso al panel /metricas y a /api/explorer/metrics
METRICS_KEY=
